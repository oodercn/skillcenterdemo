package net.ooder.skillcenter.controller;

import net.ooder.skillcenter.model.PageResponse;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.InjectMocks;
import org.mockito.MockitoAnnotations;
import org.springframework.http.ResponseEntity;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import static org.junit.jupiter.api.Assertions.*;

/**
 * StorageController 分批API单元测试
 */
public class StorageControllerTest {

    @InjectMocks
    private StorageController storageController;

    private List<Map<String, Object>> mockBackups;

    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        
        // 初始化模拟备份数据
        mockBackups = new ArrayList<>();
        for (int i = 1; i <= 12; i++) {
            Map<String, Object> backup = new HashMap<>();
            backup.put("name", "backup_" + (System.currentTimeMillis() - i * 3600000) + ".zip");
            backup.put("path", "/skillcenter/storage/backups/backup_" + (System.currentTimeMillis() - i * 3600000) + ".zip");
            backup.put("size", 1024L * 1024 * i); // 1MB * i
            backup.put("sizeHuman", i + " MB");
            backup.put("lastModified", System.currentTimeMillis() - i * 3600000); // 1小时 * i
            mockBackups.add(backup);
        }
    }

    /**
     * 测试获取备份列表的分页功能
     * 注意：由于StorageController直接操作文件系统，这里主要测试分页逻辑
     */
    @Test
    void testGetBackupList_PaginationLogic() {
        // 模拟分页逻辑测试
        int page = 1;
        int size = 5;
        int start = (page - 1) * size;
        int end = Math.min(start + size, mockBackups.size());
        List<Map<String, Object>> pagedBackups = mockBackups.subList(start, end);
        
        assertEquals(5, pagedBackups.size());
        assertEquals("backup_", pagedBackups.get(0).get("name").toString().substring(0, 7));
        
        // 测试第二页
        page = 2;
        start = (page - 1) * size;
        end = Math.min(start + size, mockBackups.size());
        pagedBackups = mockBackups.subList(start, end);
        
        assertEquals(5, pagedBackups.size());
        
        // 测试第三页
        page = 3;
        start = (page - 1) * size;
        end = Math.min(start + size, mockBackups.size());
        pagedBackups = mockBackups.subList(start, end);
        
        assertEquals(2, pagedBackups.size());
    }

    /**
     * 测试获取备份列表的排序功能
     * 注意：由于StorageController直接操作文件系统，这里主要测试排序逻辑
     */
    @Test
    void testGetBackupList_SortingLogic() {
        // 测试按大小排序（升序）
        mockBackups.sort((b1, b2) -> {
            long size1 = (Long) b1.get("size");
            long size2 = (Long) b2.get("size");
            return Long.compare(size1, size2);
        });
        
        for (int i = 0; i < mockBackups.size() - 1; i++) {
            long currentSize = (Long) mockBackups.get(i).get("size");
            long nextSize = (Long) mockBackups.get(i + 1).get("size");
            assertTrue(currentSize <= nextSize);
        }
        
        // 测试按修改时间排序（降序）
        mockBackups.sort((b1, b2) -> {
            long time1 = (Long) b1.get("lastModified");
            long time2 = (Long) b2.get("lastModified");
            return Long.compare(time2, time1); // 降序
        });
        
        for (int i = 0; i < mockBackups.size() - 1; i++) {
            long currentTime = (Long) mockBackups.get(i).get("lastModified");
            long nextTime = (Long) mockBackups.get(i + 1).get("lastModified");
            assertTrue(currentTime >= nextTime);
        }
    }

    /**
     * 测试PageResponse的构建
     */
    @Test
    void testPageResponseConstruction() {
        List<Map<String, Object>> content = mockBackups.subList(0, 5);
        PageResponse<Map<String, Object>> pageResponse = PageResponse.of(content, 1, 5, 12);
        
        assertNotNull(pageResponse);
        assertEquals(1, pageResponse.getPage());
        assertEquals(5, pageResponse.getSize());
        assertEquals(12, pageResponse.getTotalElements());
        assertEquals(3, pageResponse.getTotalPages());
        assertEquals(5, pageResponse.getContent().size());
        assertFalse(pageResponse.isHasPrevious());
        assertTrue(pageResponse.isHasNext());
        
        // 测试最后一页
        content = mockBackups.subList(10, 12);
        pageResponse = PageResponse.of(content, 3, 5, 12);
        
        assertNotNull(pageResponse);
        assertEquals(3, pageResponse.getPage());
        assertEquals(5, pageResponse.getSize());
        assertEquals(12, pageResponse.getTotalElements());
        assertEquals(3, pageResponse.getTotalPages());
        assertEquals(2, pageResponse.getContent().size());
        assertTrue(pageResponse.isHasPrevious());
        assertFalse(pageResponse.isHasNext());
    }
}
