package net.ooder.skillcenter.controller;

import net.ooder.skillcenter.market.SkillListing;
import net.ooder.skillcenter.market.SkillMarketManager;
import net.ooder.skillcenter.market.SkillReview;
import net.ooder.skillcenter.model.PageResponse;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.http.ResponseEntity;

import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.when;

/**
 * MarketController 分批API单元测试
 */
public class MarketControllerTest {

    @Mock
    private SkillMarketManager marketManager;

    @InjectMocks
    private MarketController marketController;

    private List<SkillListing> mockSkillListings;
    private List<SkillReview> mockSkillReviews;

    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        
        // 初始化模拟技能列表数据
        mockSkillListings = new ArrayList<>();
        for (int i = 1; i <= 15; i++) {
            SkillListing listing = new SkillListing();
            listing.setSkillId("skill-" + i);
            listing.setName("Skill " + i);
            listing.setCategory("Category " + (i % 3 + 1));
            listing.setRating(4.0 + (i % 5) * 0.1);
            listing.setDownloadCount(i * 10); // 添加下载次数
            mockSkillListings.add(listing);
        }
        
        // 初始化模拟评论数据
        mockSkillReviews = new ArrayList<>();
        for (int i = 1; i <= 25; i++) {
            SkillReview review = new SkillReview();
            review.setSkillId("skill-1");
            review.setUserId("user-" + (i % 10 + 1));
            review.setRating(3.0 + (i % 3));
            review.setComment("Comment " + i);
            review.setTimestamp(System.currentTimeMillis() - i * 86400000); // 每天一条评论
            mockSkillReviews.add(review);
        }
        
        // 模拟SkillMarketManager的方法
        when(marketManager.getAllSkills()).thenReturn(mockSkillListings);
        when(marketManager.searchSkills("test")).thenReturn(mockSkillListings.subList(0, 10));
        when(marketManager.getSkillsByCategory("Category 1")).thenReturn(mockSkillListings.subList(0, 5));
        when(marketManager.getSkillReviews("skill-1")).thenReturn(mockSkillReviews);
        List<String> categories = new ArrayList<>();
        categories.add("Category 1");
        categories.add("Category 2");
        categories.add("Category 3");
        when(marketManager.getCategories()).thenReturn(categories);
    }

    /**
     * 测试获取市场技能列表的分页功能
     */
    @Test
    void testGetMarketSkills_Pagination() {
        // 测试第一页
        ResponseEntity<PageResponse<SkillListing>> response1 = marketController.getMarketSkills(1, 8, null, "asc");
        PageResponse<SkillListing> page1 = response1.getBody();
        assertNotNull(page1);
        assertEquals(1, page1.getPage());
        assertEquals(8, page1.getSize());
        assertEquals(15, page1.getTotalElements());
        assertEquals(2, page1.getTotalPages());
        assertEquals(8, page1.getContent().size());
        assertFalse(page1.isHasPrevious());
        assertTrue(page1.isHasNext());

        // 测试第二页
        ResponseEntity<PageResponse<SkillListing>> response2 = marketController.getMarketSkills(2, 8, null, "asc");
        PageResponse<SkillListing> page2 = response2.getBody();
        assertNotNull(page2);
        assertEquals(2, page2.getPage());
        assertEquals(8, page2.getSize());
        assertEquals(15, page2.getTotalElements());
        assertEquals(2, page2.getTotalPages());
        assertEquals(7, page2.getContent().size());
        assertTrue(page2.isHasPrevious());
        assertFalse(page2.isHasNext());
    }

    /**
     * 测试搜索技能的分页功能
     */
    @Test
    void testSearchSkills_Pagination() {
        // 测试搜索结果的分页
        ResponseEntity<PageResponse<SkillListing>> response = marketController.searchSkills("test", 1, 5, null, "asc");
        PageResponse<SkillListing> page = response.getBody();
        assertNotNull(page);
        assertEquals(1, page.getPage());
        assertEquals(5, page.getSize());
        assertEquals(10, page.getTotalElements());
        assertEquals(2, page.getTotalPages());
        assertEquals(5, page.getContent().size());
    }

    /**
     * 测试根据分类获取技能的分页功能
     */
    @Test
    void testGetSkillsByCategory_Pagination() {
        // 测试分类技能的分页
        ResponseEntity<PageResponse<SkillListing>> response = marketController.getSkillsByCategory("Category 1", 1, 3, null, "asc");
        PageResponse<SkillListing> page = response.getBody();
        assertNotNull(page);
        assertEquals(1, page.getPage());
        assertEquals(3, page.getSize());
        assertEquals(5, page.getTotalElements());
        assertEquals(2, page.getTotalPages());
        assertEquals(3, page.getContent().size());
    }

    /**
     * 测试获取技能评论的分页功能
     */
    @Test
    void testGetSkillReviews_Pagination() {
        // 测试评论的分页
        ResponseEntity<PageResponse<SkillReview>> response = marketController.getSkillReviews("skill-1", 1, 10, "date", "desc");
        PageResponse<SkillReview> page = response.getBody();
        assertNotNull(page);
        assertEquals(1, page.getPage());
        assertEquals(10, page.getSize());
        assertEquals(25, page.getTotalElements());
        assertEquals(3, page.getTotalPages());
        assertEquals(10, page.getContent().size());
    }

    /**
     * 测试获取技能列表的排序功能
     */
    @Test
    void testGetMarketSkills_Sorting() {
        // 测试按下载次数排序（升序）
        ResponseEntity<PageResponse<SkillListing>> responseAsc = marketController.getMarketSkills(1, 10, "downloadCount", "asc");
        PageResponse<SkillListing> pageAsc = responseAsc.getBody();
        assertNotNull(pageAsc);
        // 验证排序结果
        for (int i = 0; i < pageAsc.getContent().size() - 1; i++) {
            int currentCount = pageAsc.getContent().get(i).getDownloadCount();
            int nextCount = pageAsc.getContent().get(i + 1).getDownloadCount();
            assertTrue(currentCount <= nextCount);
        }

        // 测试按下载次数排序（降序）
        ResponseEntity<PageResponse<SkillListing>> responseDesc = marketController.getMarketSkills(1, 10, "downloadCount", "desc");
        PageResponse<SkillListing> pageDesc = responseDesc.getBody();
        assertNotNull(pageDesc);
        // 验证排序结果
        for (int i = 0; i < pageDesc.getContent().size() - 1; i++) {
            int currentCount = pageDesc.getContent().get(i).getDownloadCount();
            int nextCount = pageDesc.getContent().get(i + 1).getDownloadCount();
            assertTrue(currentCount >= nextCount);
        }
    }
}
